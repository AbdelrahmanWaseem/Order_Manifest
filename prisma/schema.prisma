datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Batch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("active") // active, archived, completed

  orders    Order[]
  reports   Report[]

  @@map("batches")
}

model Order {
  id                String      @id @default(cuid())
  shopifyOrderId    String?
  shopifyOrderName  String
  source            String      @default("shopify") // "shopify" | "manual"
  customer          String
  customerPhone     String?
  customerEmail     String?
  orderDate         DateTime?   @default(now())
  notes             String?
  fulfillmentStatus String?     @default("UNFULFILLED")
  batchId           String
  batch             Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]

  @@index([batchId])
  @@index([shopifyOrderName])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyLineItemId String?
  shopifyVariantId  String?
  shopifyProductId  String?
  name              String
  brand             String
  size              String
  color             String?
  sku               String
  quantity          Int      @default(1)
  inventoryQuantity Int?
  status            String   @default("pending") // pending, ready, incoming, missing
  note              String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([sku])
  @@map("order_items")
}

model Report {
  id         String   @id // e.g. r1729000000000 or custom
  createdAt  DateTime @default(now())
  orderCount Int
  itemCount  Int
  batchId    String?
  batch      Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  snapshot   Json

  @@index([createdAt])
  @@map("reports")
}

model ManualOrder {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  customer          String
  customerPhone     String?
  customerEmail     String?
  orderDate         DateTime          @default(now())
  notes             String?
  source            String            @default("manual")
  fulfillmentStatus String            @default("UNFULFILLED")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items             ManualOrderItem[]

  @@index([orderNumber])
  @@index([customer])
  @@map("manual_orders")
}

model ManualOrderItem {
  id                String       @id @default(cuid())
  manualOrderId     String
  manualOrder       ManualOrder  @relation(fields: [manualOrderId], references: [id], onDelete: Cascade)
  productId         String?
  variantId         String?
  name              String
  brand             String       @default("Essentials EG")
  size              String       @default("—")
  color             String?
  sku               String       @default("")
  quantity          Int          @default(1)
  inventoryQuantity Int?
  status            String       @default("pending")
  note              String       @default("")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([manualOrderId])
  @@map("manual_order_items")
}
