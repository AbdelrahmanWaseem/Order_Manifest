# Database (PostgreSQL - Neon, Vercel Postgres, or Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Shopify Store Credentials (Custom App)
# Domain should be your myshopify domain or custom domain (e.g. 221224-9e.myshopify.com)
SHOPIFY_STORE_DOMAIN="221224-9e.myshopify.com"

# Admin API Access Token starting with shpat_
# Required Scopes: read_orders, read_products, read_inventory
SHOPIFY_ADMIN_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Shopify Admin API version (defaults to 2024-07 if omitted)
SHOPIFY_API_VERSION="2024-07"
